# Parameters
theta = np.linspace(0, 2*np.pi, 200)
phi = np.linspace(0, np.pi, 100) # vertical angle
theta, phi = np.meshgrid(theta, phi)

# Flower equation (3D rose-like surface)
k = 6 # controls number of petals
r = np.cos(k * theta) * np.sin(phi)
# Convert to Cartesian coordinates
x = r * np.cos(theta)
y = r * np.sin(theta)
z = np.cos(phi) * r
# Plot
fig = plt.figure(figsize=(8,6))
ax = fig.add_subplot(111, projection='3d')
ax.plot_surface(x, y, z, cmap='plasma', edgecolor='none', alpha=0.9)
# Decorations
ax.set_title("3D Flower Surface )
ax.set_xlabel("X-axis")
ax.set_ylabel("Y-axis")
ax.set_zlabel("Z-axis")
plt.show()

############################# Different Bar Plots
# Sample data
categories = ['A', 'B', 'C', 'D']
values1 = [4, 7, 3, 6]
values2 = [5, 2, 4, 5]

# Vertical bar plot
plt.figure(figsize=(6,4))
plt.bar(categories, values1, color='skyblue')
plt.title("Vertical Bar Plot")
plt.ylabel("Values")
plt.show()

# Horizontal bar plot
plt.figure(figsize=(6,4))
plt.barh(categories, values1, color='lightgreen')
plt.title("Horizontal Bar Plot")
plt.xlabel("Values")
plt.show()

# Bar plot with custom colors for each bar
colors = ['red', 'green', 'blue', 'gold']
plt.figure(figsize=(6,4))
plt.bar(categories, values1, color=colors)
plt.title("Custom Colors Bar Plot")
plt.show()

# Grouped bar plot
x = np.arange(len(categories))
width = 0.35
plt.figure(figsize=(6,4))
plt.bar(x - width/2, values1, width, label='Group 1', color='orange')
plt.bar(x + width/2, values2, width, label='Group 2', color='blue')
plt.xticks(x, categories)
plt.title("Grouped Bar Plot")
plt.legend()
plt.show()

# Stacked bar plot
plt.figure(figsize=(6,4))
plt.bar(categories, values1, color='purple', label='Group 1')
plt.bar(categories, values2, bottom=values1, color='pink', label='Group 2')
plt.title("Stacked Bar Plot")
plt.legend()
plt.show()

####################### line charts
# Sample data
x = np.linspace(0, 10, 500)
y1 = np.sin(x)
y2 = np.cos(x)

# Simple line chart
plt.figure(figsize=(6,4))
plt.plot(x, y1, color='blue')
plt.title("Simple Line Chart")
plt.xlabel("X")
plt.ylabel("Y")
plt.show()

# Multiple lines on the same plot
plt.figure(figsize=(6,4))
plt.plot(x, y1, label='sin(x)', color='blue')
plt.plot(x, y2, label='cos(x)', color='red')
plt.title("Multiple Lines")
plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.show()

# Dashed and dotted line styles
plt.figure(figsize=(6,4))
plt.plot(x, y1, linestyle='--', label='Dashed', color='green')
plt.plot(x, y2, linestyle=':', label='Dotted', color='orange')
plt.title("Different Line Styles")
plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.show()

# Line chart with markers
plt.figure(figsize=(6,4))
plt.plot(x, y1, marker='o', markersize=4, label='sin(x)', color='purple')
plt.plot(x, y2, marker='s', markersize=4, label='cos(x)', color='brown')
plt.title("Line Chart with Markers")
plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.show()

# Line chart with shaded area
plt.figure(figsize=(6,4))
plt.plot(x, y1, color='blue', label='sin(x)')
plt.fill_between(x, y1, alpha=0.3, color='blue')
plt.title("Line Chart with Shaded Area")
plt.xlabel("X")
plt.ylabel("Y")
plt.legend()
plt.show()
