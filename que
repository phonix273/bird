import numpy as np

p = 0.03

# (i)
prob_within_5 = 1 - (1 - p)**5

# (ii)
poisson_approx = 1 - np.exp(-5 * p)

# (iii)
expected_before_defective = 1 / p
expected_in_10000 = 10000 * expected_before_defective

print("P(defective within 5 bulbs) =", prob_within_5)
print("Poisson approximation =", poisson_approx)
print("Expected bulbs before first defective =", expected_before_defective)
print("Expected total in 10,000 runs =", expected_in_10000)
   
